<Application
    x:Class="Noti.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF09090B" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CC121216" />
                    <AcrylicBrush x:Key="PopupAcrylicBrush" TintColor="#FF121216" TintOpacity="0.18" TintLuminosityOpacity="0.18" FallbackColor="#B8121216" />
                    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FF050507" />
                    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#B8000000" />
                    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA1A1AA" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA1A1A6" />
                    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1EFFFFFF" Offset="0.0" />
                        <GradientStop Color="#0DFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#2AFFFFFF" />
                    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#F0FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#01000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#01000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#01000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF09090B" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CC121216" />
                    <AcrylicBrush x:Key="PopupAcrylicBrush" TintColor="#FF121216" TintOpacity="0.18" TintLuminosityOpacity="0.18" FallbackColor="#B8121216" />
                    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FF050507" />
                    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#B8000000" />
                    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA1A1AA" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA1A1A6" />
                    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1EFFFFFF" Offset="0.0" />
                        <GradientStop Color="#0DFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#2AFFFFFF" />
                    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#F0FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#01000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#01000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#01000000" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#CCF5F5F7" />
                    <AcrylicBrush x:Key="PopupAcrylicBrush" TintColor="#FFFFFFFF" TintOpacity="0.22" TintLuminosityOpacity="0.24" FallbackColor="#C8F5F5F7" />
                    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#1C000000" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FFFAFAFC" />
                    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#70000000" />
                    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#1E000000" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF52525B" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8E8E93" />
                    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#12000000" Offset="0.0" />
                        <GradientStop Color="#08000000" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#1C000000" />
                    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#01FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#01FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#01FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FF000000" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF000000" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF000000" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6C6C70" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6C6C70" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF6C6C70" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Clean Borderless TextBox Style (eliminates WinUI Fluent bottom underline / elevation border artifact) -->
            <Style x:Key="BorderlessTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SelectionHighlightColor" Value="#FF0A84FF" />
                <Setter Property="SelectionHighlightColorWhenNotFocused" Value="#880A84FF" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                        <VisualState x:Name="Focused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="BorderElement"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0" />
                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                    Text="{TemplateBinding PlaceholderText}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextWrapping="{TemplateBinding TextWrapping}"
                                    IsHitTestVisible="False" />
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Foreground="{TemplateBinding Foreground}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                    IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                    IsTabStop="False"
                                    ZoomMode="Disabled"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource BorderlessTextBoxStyle}" />

            <!-- Borderless Circular 34x34 Liquid Glass Icon Button (scales background surface only, keeping glyphs crisp) -->
            <Style x:Key="GlassIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="34" Height="34" Background="Transparent" UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SurfaceScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.14" FillBehavior="Stop" />
                                                <DoubleAnimation Storyboard.TargetName="SurfaceScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.14" FillBehavior="Stop" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SurfaceScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="SurfaceScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12" />
                                            </Storyboard>
                                            <VisualState.Setters>
                                                <Setter Target="GlassSurface.Fill" Value="{ThemeResource GlassFillHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SurfaceScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="SurfaceScale" Storyboard.TargetProperty="ScaleY" To="0.90" Duration="0:0:0.08" />
                                            </Storyboard>
                                            <VisualState.Setters>
                                                <Setter Target="GlassSurface.Fill" Value="{ThemeResource GlassFillPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Ellipse
                                    x:Name="GlassSurface"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding Background}"
                                    StrokeThickness="0"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact 26x26 Subtle Action Icon Button -->
            <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="26" Height="26" Background="Transparent" UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BtnBorder.Background" Value="{ThemeResource GlassFillHoverBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BtnBorder.Background" Value="{ThemeResource GlassFillPressedBrush}" />
                                                <Setter Target="Presenter.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="BtnBorder"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}" />
                                <ContentPresenter
                                    x:Name="Presenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Borderless Liquid Glass Pill Action Button (no ScaleTransform on text so DirectWrite stays 100% sharp) -->
            <Style x:Key="GlassPillButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="PillBorder"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PillBorder.Background" Value="{ThemeResource GlassFillHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="PillBorder.Background" Value="{ThemeResource GlassFillPressedBrush}" />
                                                <Setter Target="Presenter.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="Presenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segment Tab Button for Write / Split / View Switcher (stationary pixel-snapped text) -->
            <Style x:Key="SegmentTabButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="60" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="60" Height="26" Background="Transparent" UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.85" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="Presenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Crisp Sidebar List Item Style (hover surface is placed inside the indented DataTemplate so nested items never double-box) -->
            <Style x:Key="MinimalListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter
                                UseLayoutRounding="True"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Borderless Raycast-Style Command Palette Row Style (Selected + PointerOver states) -->
            <Style x:Key="CommandPaletteItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid Background="Transparent" UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ItemSurface.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                                <Setter Target="ItemSurface.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ItemSurface.Background" Value="{ThemeResource SurfaceActiveBrush}" />
                                                <Setter Target="ItemSurface.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="ItemSurface.Background" Value="{ThemeResource SurfaceActiveBrush}" />
                                                <Setter Target="ItemSurface.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="ItemSurface.Background" Value="{ThemeResource SurfaceActiveBrush}" />
                                                <Setter Target="ItemSurface.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="ItemSurface.Background" Value="{ThemeResource SurfaceActiveBrush}" />
                                                <Setter Target="ItemSurface.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="ItemSurface"
                                    CornerRadius="12"
                                    Background="{ThemeResource SurfaceHoverBrush}"
                                    Opacity="0" />
                                <ContentPresenter
                                    UseLayoutRounding="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
