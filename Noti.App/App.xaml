<Application
    x:Class="Noti.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF121214" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FF161618" />
                    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#FF161616" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF262626" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="GlassHaloBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#29FFFFFF" />
                    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#38FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF121214" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FF161618" />
                    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#FF161616" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF262626" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="GlassHaloBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#29FFFFFF" />
                    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#38FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#FFF2F2F7" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFF9F9FB" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFF2F2F7" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FFF9F9FB" />
                    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#FFE5E5EA" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFD1D1D6" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6C6C70" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="GlassFillBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="GlassHaloBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="GlassIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="36" Height="36">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="GlassSurface.Background" Value="{ThemeResource GlassFillHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="GlassSurface.Background" Value="{ThemeResource GlassFillPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    CornerRadius="18"
                                    BorderBrush="{ThemeResource GlassHaloBrush}"
                                    BorderThickness="2" />
                                <Border
                                    x:Name="GlassSurface"
                                    Margin="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="17">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MinimalListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
