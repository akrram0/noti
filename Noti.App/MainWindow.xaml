<Window
    x:Class="Noti.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Noti.App.ViewModels"
    Title="Noti">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CanvasBackgroundBrush}"
        RequestedTheme="{x:Bind ViewModel.CurrentElementTheme, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Grid
            Grid.Row="0"
            BorderBrush="{ThemeResource SubtleDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <Button
                    Style="{StaticResource GlassIconButtonStyle}"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    ToolTipService.ToolTip="Toggle sidebar">
                    <Border
                        Width="14"
                        Height="12"
                        CornerRadius="3"
                        BorderBrush="{ThemeResource TextPrimaryBrush}"
                        BorderThickness="1.5">
                        <Border
                            Width="1.5"
                            HorizontalAlignment="Left"
                            Margin="3,0,0,0"
                            Background="{ThemeResource TextPrimaryBrush}" />
                    </Border>
                </Button>

                <TextBlock
                    Text="Noti"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMutedBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Grid
                x:Name="AppTitleBar"
                Grid.Column="1"
                Background="Transparent" />
        </Grid>

        <!-- Workspace Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.SidebarWidth, Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Grid
                Grid.Column="0"
                Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}"
                BorderBrush="{ThemeResource SubtleDividerBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <!-- Search & New Note -->
                <Grid Grid.Row="0" Padding="16,16,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="36"
                        CornerRadius="18"
                        Background="{ThemeResource InputBackgroundBrush}"
                        BorderBrush="{ThemeResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="14,0">
                        <TextBox
                            PlaceholderText="Search"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.CreateNoteCommand}"
                        ToolTipService.ToolTip="New note">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Scrollable Note List -->
                <ListView
                    Grid.Row="1"
                    Padding="16,8"
                    SelectionMode="Single"
                    ItemsSource="{x:Bind ViewModel.FilteredNotes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource MinimalListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteItemViewModel">
                            <Grid Margin="0,0,0,4">
                                <Border
                                    Background="{ThemeResource SurfaceActiveBrush}"
                                    CornerRadius="12"
                                    Opacity="{x:Bind SelectionOpacity, Mode=OneWay}" />
                                <StackPanel Padding="16,12" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Snippet, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Inline Settings Card -->
                <Border
                    Grid.Row="2"
                    Margin="16,8,16,8"
                    Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource SettingsSurfaceBrush}"
                    BorderBrush="{ThemeResource ControlBorderBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Settings"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <Grid>
                            <TextBlock
                                Text="Dark mode"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                HorizontalAlignment="Right"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ToggleThemeCommand}"
                                ToolTipService.ToolTip="Toggle dark mode">
                                <Border
                                    Width="48"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{ThemeResource ToggleTrackBrush}"
                                    BorderBrush="{ThemeResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Padding="3">
                                    <Border
                                        Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="{ThemeResource ToggleThumbBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="{x:Bind ViewModel.ToggleThumbAlignment, Mode=OneWay}" />
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sidebar Footer -->
                <StackPanel
                    Grid.Row="3"
                    Padding="16,0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Button
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <TextBlock
                        Text="{x:Bind ViewModel.NoteCountText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Main Editor -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <TextBox
                    Grid.Row="0"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="16"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="48,32,48,16"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>

                <!-- Status Bar -->
                <Grid Grid.Row="1" Padding="48,0">
                    <TextBlock
                        Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
