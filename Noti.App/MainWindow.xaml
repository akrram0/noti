<Window
    x:Class="Noti.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Noti.App.ViewModels"
    Title="Noti">

    <Grid
        x:Name="RootGrid"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnRootGridDragOver"
        Drop="OnRootGridDrop"
        PointerWheelChanged="OnRootPointerWheelChanged"
        Background="{ThemeResource CanvasBackgroundBrush}"
        RequestedTheme="{x:Bind ViewModel.CurrentElementTheme, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Borderless Top Title Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource CanvasBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Animated Sidebar Toggle, Brand & Active Folder Pill -->
            <StackPanel
                Grid.Column="0"
                Margin="14,0,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <Button
                    x:Name="SidebarToggleButton"
                    Style="{StaticResource GlassIconButtonStyle}"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    ToolTipService.ToolTip="Toggle sidebar (Ctrl+\)">
                    <Canvas Width="14" Height="12" UseLayoutRounding="True">
                        <Rectangle
                            Width="14"
                            Height="12"
                            RadiusX="2"
                            RadiusY="2"
                            Stroke="{ThemeResource TextPrimaryBrush}"
                            StrokeThickness="1.5" />
                        <Line
                            x:Name="SidebarIconDivider"
                            X1="5"
                            Y1="1"
                            X2="5"
                            Y2="11"
                            Stroke="{ThemeResource TextPrimaryBrush}"
                            StrokeThickness="1.5">
                            <Line.RenderTransform>
                                <TranslateTransform x:Name="SidebarIconTranslate" X="0" />
                            </Line.RenderTransform>
                        </Line>
                    </Canvas>
                </Button>

                <TextBlock
                    Text="Noti"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    VerticalAlignment="Center" />

                <Border
                    Padding="8,3"
                    CornerRadius="8"
                    Background="{ThemeResource InputBackgroundBrush}"
                    BorderThickness="0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.ActiveFolderBadgeText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Center: Borderless Write | Split | View Mode Switcher -->
            <Border
                x:Name="ViewSwitcherBorder"
                Grid.Column="1"
                Width="184"
                Height="30"
                Padding="2"
                CornerRadius="15"
                Background="{ThemeResource InputBackgroundBrush}"
                BorderThickness="0"
                VerticalAlignment="Center">
                <Grid>
                    <Border
                        x:Name="ModeIndicatorBorder"
                        Width="60"
                        Height="26"
                        CornerRadius="13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SurfaceActiveBrush}"
                        BorderThickness="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ModeIndicatorTranslate" X="0" />
                        </Border.RenderTransform>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button
                            Content="Write"
                            Style="{StaticResource SegmentTabButtonStyle}"
                            Command="{x:Bind ViewModel.SetWriteModeCommand}"
                            ToolTipService.ToolTip="Write mode" />
                        <Button
                            Content="Split"
                            Style="{StaticResource SegmentTabButtonStyle}"
                            Command="{x:Bind ViewModel.SetSplitModeCommand}"
                            ToolTipService.ToolTip="Split Editor &amp; Live Markdown View" />
                        <Button
                            Content="View"
                            Style="{StaticResource SegmentTabButtonStyle}"
                            Command="{x:Bind ViewModel.SetViewModeCommand}"
                            ToolTipService.ToolTip="Rendered Markdown View (Ctrl+E)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Compact Zoom Badge & Update Pill (padded left of window caption buttons) -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,148,0"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Button
                    x:Name="UpdateTopBarButton"
                    Content="{x:Bind ViewModel.UpdateTopBarText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.UpdatePillVisibility, Mode=OneWay}"
                    Style="{StaticResource GlassPillButtonStyle}"
                    Command="{x:Bind ViewModel.InstallUpdateCommand}"
                    ToolTipService.ToolTip="Click to download and install the latest update silently" />
                <Button
                    x:Name="ZoomBadgeButton"
                    Content="{x:Bind ViewModel.ZoomPercentText, Mode=OneWay}"
                    Height="26"
                    Padding="10,0"
                    Style="{StaticResource GlassPillButtonStyle}"
                    Command="{x:Bind ViewModel.ResetZoomCommand}"
                    ToolTipService.ToolTip="Zoom level (Ctrl + + / Ctrl + - to zoom, Click or Ctrl+0 to reset)" />
            </StackPanel>
        </Grid>

        <!-- Workspace & Full-Window Settings Container -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Borderless Elevated Sidebar with Rounded Card Corners, Nested File Tree & User Profile -->
            <Grid
                x:Name="SidebarContainer"
                Grid.Column="0"
                Width="272"
                UseLayoutRounding="True"
                Background="Transparent">
                <Grid
                    Margin="8,0,0,8"
                    CornerRadius="16"
                    Background="{ThemeResource SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>

                <!-- Search, New Note & New Folder -->
                <Grid Grid.Row="0" Padding="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="34"
                        CornerRadius="17"
                        Background="{ThemeResource InputBackgroundBrush}"
                        BorderThickness="0">
                        <TextBox
                            PlaceholderText="Search"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="13"
                            MinHeight="0"
                            Height="32"
                            Padding="14,6,14,6"
                            IsSpellCheckEnabled="False"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FF1C1C1E" />
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF1C1C1E" />
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1C1C1E" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6C6C70" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6C6C70" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF6C6C70" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.CreateNoteCommand}"
                        ToolTipService.ToolTip="New note (Ctrl+N)">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.StartNewFolderCommand}"
                        ToolTipService.ToolTip="New folder (Ctrl+Shift+N)">
                        <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                    </Button>
                </Grid>

                <!-- Inline New Folder Input Bar -->
                <Border
                    Grid.Row="1"
                    Margin="14,0,14,8"
                    Padding="10,6"
                    CornerRadius="12"
                    Background="{ThemeResource InputBackgroundBrush}"
                    BorderThickness="0"
                    Visibility="{x:Bind ViewModel.NewFolderBoxVisibility, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="NewFolderTextBox"
                            Grid.Column="0"
                            PlaceholderText="Folder path (e.g. Work/Ideas)"
                            Text="{x:Bind ViewModel.NewFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="OnNewFolderTextBoxKeyDown"
                            FontSize="12"
                            MinHeight="0"
                            Height="26"
                            Padding="4,4,4,4"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            Command="{x:Bind ViewModel.ConfirmNewFolderCommand}"
                            ToolTipService.ToolTip="Create folder">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            Command="{x:Bind ViewModel.CancelNewFolderCommand}"
                            ToolTipService.ToolTip="Cancel">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Hierarchical File Tree & Note List -->
                <ListView
                    Grid.Row="2"
                    Padding="12,4"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnSidebarItemClick"
                    ItemsSource="{x:Bind ViewModel.FilteredNotes, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource MinimalListViewItemStyle}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteItemViewModel">
                            <Grid Margin="{x:Bind IndentMargin, Mode=OneWay}">
                                <!-- Folder Row with Open/Closed Icon + Add Note + Delete Folder -->
                                <Border
                                    Visibility="{x:Bind FolderVisibility, Mode=OneWay}"
                                    Padding="10,7"
                                    CornerRadius="10"
                                    Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                            FontSize="9"
                                            Margin="0,0,6,0"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            VerticalAlignment="Center" />

                                        <FontIcon
                                            Grid.Column="1"
                                            Glyph="{x:Bind FolderIconGlyph, Mode=OneWay}"
                                            FontSize="14"
                                            Margin="0,0,8,0"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind FolderCountText, Mode=OneWay}"
                                            FontSize="11"
                                            Margin="6,0,4,0"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            VerticalAlignment="Center" />

                                        <Button
                                            Grid.Column="4"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Tag="{x:Bind FolderPath, Mode=OneWay}"
                                            Click="OnCreateNoteInFolderClick"
                                            ToolTipService.ToolTip="New note in folder">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>

                                        <Button
                                            Grid.Column="5"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Tag="{x:Bind FolderPath, Mode=OneWay}"
                                            Opacity="0.65"
                                            Click="OnDeleteFolderClick"
                                            ToolTipService.ToolTip="Delete folder and its notes">
                                            <FontIcon Glyph="&#xE74D;" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Note Card Row -->
                                <Grid Visibility="{x:Bind NoteVisibility, Mode=OneWay}">
                                    <Border
                                        Background="{ThemeResource SurfaceActiveBrush}"
                                        CornerRadius="12"
                                        Opacity="{x:Bind SelectionOpacity, Mode=OneWay}" />
                                    <Grid Padding="12,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    Glyph="&#xE840;"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                                    Visibility="{x:Bind PinBadgeVisibility, Mode=OneWay}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind Snippet, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">
                                            <Button
                                                Style="{StaticResource SubtleIconButtonStyle}"
                                                Tag="{x:Bind}"
                                                Opacity="{x:Bind PinOpacity, Mode=OneWay}"
                                                Click="OnTogglePinNoteClick"
                                                ToolTipService.ToolTip="Pin note to top">
                                                <FontIcon Glyph="{x:Bind PinIconGlyph, Mode=OneWay}" FontSize="11" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource SubtleIconButtonStyle}"
                                                Tag="{x:Bind}"
                                                Opacity="0.45"
                                                Click="OnDeleteNoteItemClick"
                                                ToolTipService.ToolTip="Delete note (Ctrl+Delete)">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Sidebar Footer: User Profile (Avatar + Name + Note Count) & Animated Settings Gear -->
                <Grid Grid.Row="3" Padding="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        ToolTipService.ToolTip="Profile &amp; Settings">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse
                                    Width="32"
                                    Height="32"
                                    Fill="{ThemeResource SurfaceActiveBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.UserInitials, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.UserInitialsVisibility, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Border
                                    Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Visibility="{x:Bind ViewModel.UserAvatarVisibility, Mode=OneWay}">
                                    <Image
                                        Source="{x:Bind ViewModel.UserAvatarSource, Mode=OneWay}"
                                        Stretch="UniformToFill" />
                                </Border>
                            </Grid>

                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.DisplayUserName, Mode=OneWay}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.NoteCountText, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon
                            Glyph="&#xE713;"
                            FontSize="14"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="SettingsGearRotate" Angle="0" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </Grid>
                </Grid>
            </Grid>

            <!-- Right Column: Main Editor/Preview Canvas OR Full-Window Settings View -->
            <Grid Grid.Column="1">

                <!-- 1. Main Writing & Markdown Preview Workspace -->
                <Grid x:Name="MainWorkspaceGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <!-- Editor & Live Markdown Preview Split Grid -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind ViewModel.EditorColumnWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ViewModel.PreviewColumnWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>

                        <!-- Left / Primary: Plain Markdown Editor + Word-Pop Typing Animation -->
                        <Grid
                            x:Name="EditorPaneGrid"
                            Grid.Column="0"
                            Visibility="{x:Bind ViewModel.EditorPaneVisibility, Mode=OneWay}">
                            <TextBox
                                x:Name="EditorTextBox"
                                UseLayoutRounding="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                IsSpellCheckEnabled="False"
                                MinHeight="0"
                                PlaceholderText="Start writing... (Shift+Enter for connected tree, Tab to indent)"
                                Text="{x:Bind ViewModel.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="{x:Bind ViewModel.EditorFontSize, Mode=OneWay}"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="40,28,40,16"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TextBox.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Default">
                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlForeground" Color="#FF1C1C1E" />
                                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF1C1C1E" />
                                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1C1C1E" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6C6C70" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6C6C70" />
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF6C6C70" />
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Floating Word-Pop Animation Pill (Borderless, Crisp Opacity Fade) -->
                            <Border
                                x:Name="TypingWordPopupBorder"
                                UseLayoutRounding="True"
                                IsHitTestVisible="False"
                                Opacity="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,16,28,0"
                                Padding="12,5"
                                CornerRadius="12"
                                Background="{ThemeResource SurfaceActiveBrush}"
                                BorderThickness="0">
                                <TextBlock
                                    x:Name="TypingWordText"
                                    Text=""
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- Right / Rendered Markdown Viewer -->
                        <ScrollViewer
                            x:Name="PreviewScrollViewer"
                            Grid.Column="1"
                            Visibility="{x:Bind ViewModel.PreviewPaneVisibility, Mode=OneWay}"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                x:Name="MarkdownPreviewPanel"
                                UseLayoutRounding="True"
                                Padding="36,28,36,24"
                                Spacing="4" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Borderless Bottom Status Bar -->
                    <Grid x:Name="StatusBarGrid" Grid.Row="1" Padding="40,0">
                        <TextBlock
                            x:Name="WordCountLabel"
                            Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 2. Full-Window In-App Settings View (Borderless, Crisp Opacity Transition) -->
                <Grid
                    x:Name="SettingsOverlayGrid"
                    UseLayoutRounding="True"
                    Visibility="Collapsed"
                    Opacity="0"
                    Background="{ThemeResource CanvasBackgroundBrush}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,20,32,36">
                        <StackPanel MaxWidth="660" HorizontalAlignment="Stretch" Spacing="20">

                            <!-- Top Header Bar with Back to Notes Button -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource GlassIconButtonStyle}"
                                        Command="{x:Bind ViewModel.CloseSettingsCommand}"
                                        ToolTipService.ToolTip="Back to notes (Esc)">
                                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    </Button>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="Settings &amp; Profile"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock
                                            Text="Personalize your profile, smart theme, zoom, and Markdown vault"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="Done"
                                    Style="{StaticResource GlassPillButtonStyle}"
                                    Command="{x:Bind ViewModel.CloseSettingsCommand}" />
                            </Grid>

                            <!-- Section 1: User Profile (Avatar Picture + Display Name) -->
                            <Border
                                Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource InputBackgroundBrush}"
                                BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar Circle -->
                                    <Button
                                        Grid.Column="0"
                                        Padding="0"
                                        Margin="0,0,18,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnPickUserAvatarClick"
                                        ToolTipService.ToolTip="Click to upload profile picture">
                                        <Grid Width="64" Height="64">
                                            <Ellipse
                                                Width="64"
                                                Height="64"
                                                Fill="{ThemeResource SurfaceActiveBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.UserInitials, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.UserInitialsVisibility, Mode=OneWay}"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                            <Border
                                                Width="64"
                                                Height="64"
                                                CornerRadius="32"
                                                Visibility="{x:Bind ViewModel.UserAvatarVisibility, Mode=OneWay}">
                                                <Image
                                                    Source="{x:Bind ViewModel.UserAvatarSource, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- Profile Name & Photo Buttons -->
                                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="YOUR PROFILE"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextSecondaryBrush}" />

                                        <Border
                                            CornerRadius="12"
                                            Background="{ThemeResource SurfaceActiveBrush}"
                                            BorderThickness="0">
                                            <TextBox
                                                PlaceholderText="Your display name"
                                                Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsSpellCheckEnabled="False"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                MinHeight="0"
                                                Padding="14,8"
                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Content="Upload Picture..."
                                                Style="{StaticResource GlassPillButtonStyle}"
                                                Click="OnPickUserAvatarClick" />
                                            <Button
                                                Content="Remove Picture"
                                                Visibility="{x:Bind ViewModel.RemoveAvatarVisibility, Mode=OneWay}"
                                                Style="{StaticResource GlassPillButtonStyle}"
                                                Command="{x:Bind ViewModel.ClearUserAvatarCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section 2: Smart Theme, Zoom & Typing Animations -->
                            <Border
                                Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource InputBackgroundBrush}"
                                BorderThickness="0">
                                <StackPanel Spacing="16">
                                    <TextBlock
                                        Text="APPEARANCE, SMART THEME &amp; ZOOM"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextSecondaryBrush}" />

                                    <!-- Smart Theme Switcher (Auto System | Dark | Light) -->
                                    <Grid>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="Theme mode"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Text="Auto follows your Windows system dark/light schedule"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <Border
                                            Width="184"
                                            Height="30"
                                            Padding="2"
                                            CornerRadius="15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource CanvasBackgroundBrush}"
                                            BorderThickness="0">
                                            <Grid>
                                                <Border
                                                    Width="60"
                                                    Height="26"
                                                    CornerRadius="13"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SurfaceActiveBrush}"
                                                    BorderThickness="0">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="ThemeIndicatorTranslate" X="0" />
                                                    </Border.RenderTransform>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="0">
                                                    <Button
                                                        Content="Auto"
                                                        Style="{StaticResource SegmentTabButtonStyle}"
                                                        Command="{x:Bind ViewModel.SetSystemThemeCommand}" />
                                                    <Button
                                                        Content="Dark"
                                                        Style="{StaticResource SegmentTabButtonStyle}"
                                                        Command="{x:Bind ViewModel.SetDarkThemeCommand}" />
                                                    <Button
                                                        Content="Light"
                                                        Style="{StaticResource SegmentTabButtonStyle}"
                                                        Command="{x:Bind ViewModel.SetLightThemeCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Zoom & Font Scale (Ctrl++ / Ctrl+-) -->
                                    <Grid>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="Editor zoom &amp; text size"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Text="Use Ctrl + Plus, Ctrl + Minus, or Ctrl + MouseWheel anywhere"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Button
                                                Content="−"
                                                Style="{StaticResource GlassPillButtonStyle}"
                                                Command="{x:Bind ViewModel.DecreaseFontSizeCommand}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.ZoomPercentText, Mode=OneWay}"
                                                Width="52"
                                                TextAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Content="+"
                                                Style="{StaticResource GlassPillButtonStyle}"
                                                Command="{x:Bind ViewModel.IncreaseFontSizeCommand}" />
                                            <Button
                                                Content="Reset"
                                                Style="{StaticResource GlassPillButtonStyle}"
                                                Command="{x:Bind ViewModel.ResetZoomCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fluid Word Typing Animation -->
                                    <Grid>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="Fluid word typing animation"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Text="Smooth floating word pop &amp; micro-spring feedback as you type"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.ToggleFluidAnimationCommand}">
                                            <Border
                                                Width="48"
                                                Height="26"
                                                CornerRadius="13"
                                                Background="{ThemeResource ToggleTrackBrush}"
                                                BorderThickness="0"
                                                Padding="3,0">
                                                <Ellipse
                                                    Width="20"
                                                    Height="20"
                                                    Fill="{ThemeResource ToggleThumbBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="{x:Bind ViewModel.FluidToggleThumbAlignment, Mode=OneWay}" />
                                            </Border>
                                        </Button>
                                    </Grid>

                                    <!-- Connected Tree Shortcut -->
                                    <Grid>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="Connected tree shortcut (Shift+Enter)"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Text="Build compact ├─ / └── trees with Shift+Enter and Tab nesting"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.ToggleTreeShortcutCommand}">
                                            <Border
                                                Width="48"
                                                Height="26"
                                                CornerRadius="13"
                                                Background="{ThemeResource ToggleTrackBrush}"
                                                BorderThickness="0"
                                                Padding="3,0">
                                                <Ellipse
                                                    Width="20"
                                                    Height="20"
                                                    Fill="{ThemeResource ToggleThumbBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="{x:Bind ViewModel.TreeToggleThumbAlignment, Mode=OneWay}" />
                                            </Border>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Markdown Files & Vault Storage -->
                            <Border
                                Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource InputBackgroundBrush}"
                                BorderThickness="0">
                                <StackPanel Spacing="12">
                                    <TextBlock
                                        Text="MARKDOWN FILES &amp; VAULT STORAGE"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.VaultDirectoryPath, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Content="Import .md (Ctrl+O)"
                                            Style="{StaticResource GlassPillButtonStyle}"
                                            Click="OnImportMarkdownClick" />
                                        <Button
                                            Content="Export .md (Ctrl+Shift+S)"
                                            Style="{StaticResource GlassPillButtonStyle}"
                                            Click="OnExportMarkdownClick" />
                                        <Button
                                            Content="Change Vault Folder..."
                                            Style="{StaticResource GlassPillButtonStyle}"
                                            Click="OnChangeVaultFolderClick" />
                                        <Button
                                            Content="Open in Explorer"
                                            Style="{StaticResource GlassPillButtonStyle}"
                                            Command="{x:Bind ViewModel.OpenVaultFolderCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: In-App Updates -->
                            <Border
                                Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource InputBackgroundBrush}"
                                BorderThickness="0">
                                <Grid>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="IN-APP UPDATES (GITHUB RELEASES)"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                                        Style="{StaticResource GlassPillButtonStyle}"
                                        Command="{x:Bind ViewModel.CheckOrInstallUpdateCommand}" />
                                </Grid>
                            </Border>

                            <!-- Section 5: Keyboard Shortcuts -->
                            <Border
                                Padding="20"
                                CornerRadius="16"
                                Background="{ThemeResource InputBackgroundBrush}"
                                BorderThickness="0">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="KEYBOARD SHORTCUTS"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Margin="0,0,0,4" />

                                    <Grid><TextBlock Text="Zoom In / Zoom Out / Reset Zoom" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + Plus / Ctrl + Minus / Ctrl + 0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Insert / continue connected tree branch" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Shift + Enter" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Indent / outdent tree branch" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Tab / Shift + Tab" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Cycle Write / Split / View mode" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + E" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="New note / New folder" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + N / Ctrl + Shift + N" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Import .md / Export .md" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + O / Ctrl + Shift + S" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Bold / Italic / Checklist (- [ ])" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + B / Ctrl + I / Ctrl + K" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Heading 1 / 2 / 3" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + 1 / 2 / 3" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Delete selected note" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + Delete" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                    <Grid><TextBlock Text="Toggle Sidebar / Full-Window Settings" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" /><TextBlock Text="Ctrl + \ / Ctrl + ," FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" /></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Custom Borderless Apple/macOS Folder Deletion Confirmation Card -->
        <Grid
            x:Name="DeleteFolderConfirmOverlay"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            Opacity="0"
            Background="{ThemeResource ModalBackdropBrush}">
            <Border
                Width="340"
                Padding="24"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SidebarBackgroundBrush}"
                BorderThickness="0">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="DeleteFolderConfirmTitle"
                            Text="Delete folder?"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="Are you sure you want to delete this folder and all notes inside it?"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                        <Button
                            Content="Cancel"
                            Style="{StaticResource GlassPillButtonStyle}"
                            Click="OnCancelDeleteFolderClick" />
                        <Button
                            Content="Delete Folder"
                            Style="{StaticResource GlassPillButtonStyle}"
                            Click="OnConfirmDeleteFolderClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
