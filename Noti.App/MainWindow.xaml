<Window
    x:Class="Noti.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Noti.App.ViewModels"
    Title="Noti">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CanvasBackgroundBrush}"
        RequestedTheme="{x:Bind ViewModel.CurrentElementTheme, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Grid
            Grid.Row="0"
            BorderBrush="{ThemeResource SubtleDividerBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Margin="16,0,0,0"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <Button
                    x:Name="SidebarToggleButton"
                    Style="{StaticResource GlassIconButtonStyle}"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    ToolTipService.ToolTip="Toggle sidebar">
                    <Canvas Width="14" Height="12" UseLayoutRounding="False">
                        <Rectangle
                            Width="14"
                            Height="12"
                            RadiusX="2.5"
                            RadiusY="2.5"
                            Stroke="{ThemeResource TextPrimaryBrush}"
                            StrokeThickness="1.3" />
                        <Line
                            X1="5"
                            Y1="1"
                            X2="5"
                            Y2="11"
                            Stroke="{ThemeResource TextPrimaryBrush}"
                            StrokeThickness="1.3" />
                    </Canvas>
                </Button>

                <TextBlock
                    Text="Noti"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextMutedBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Workspace Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.SidebarWidth, Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Grid
                Grid.Column="0"
                Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}"
                BorderBrush="{ThemeResource SubtleDividerBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <!-- Search & New Note -->
                <Grid Grid.Row="0" Padding="16,16,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="36"
                        CornerRadius="18"
                        Background="{ThemeResource InputBackgroundBrush}"
                        BorderBrush="{ThemeResource ControlBorderBrush}"
                        BorderThickness="1">
                        <TextBox
                            PlaceholderText="Search"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14"
                            MinHeight="0"
                            Height="34"
                            Padding="14,6,14,6"
                            IsSpellCheckEnabled="False"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FF1C1C1E" />
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF1C1C1E" />
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1C1C1E" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6C6C70" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6C6C70" />
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF6C6C70" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.CreateNoteCommand}"
                        ToolTipService.ToolTip="New note">
                        <Canvas Width="12" Height="12" UseLayoutRounding="False">
                            <Line
                                X1="6"
                                Y1="1"
                                X2="6"
                                Y2="11"
                                Stroke="{ThemeResource TextPrimaryBrush}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Line
                                X1="1"
                                Y1="6"
                                X2="11"
                                Y2="6"
                                Stroke="{ThemeResource TextPrimaryBrush}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>

                <!-- Scrollable Note List -->
                <ListView
                    Grid.Row="1"
                    Padding="16,8"
                    SelectionMode="Single"
                    ItemsSource="{x:Bind ViewModel.FilteredNotes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource MinimalListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteItemViewModel">
                            <Grid Margin="0,0,0,4">
                                <Border
                                    Background="{ThemeResource SurfaceActiveBrush}"
                                    CornerRadius="12"
                                    Opacity="{x:Bind SelectionOpacity, Mode=OneWay}" />
                                <StackPanel Padding="16,12" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Snippet, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Inline Settings Card -->
                <Border
                    x:Name="SettingsCardBorder"
                    Grid.Row="2"
                    Margin="16,8,16,8"
                    Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource SettingsSurfaceBrush}"
                    BorderBrush="{ThemeResource ControlBorderBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SettingsTranslate" />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Settings"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextSecondaryBrush}" />

                        <!-- Dark Mode Toggle -->
                        <Grid>
                            <TextBlock
                                Text="Dark mode"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                HorizontalAlignment="Right"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ToggleThemeCommand}"
                                ToolTipService.ToolTip="Toggle dark mode">
                                <Border
                                    Width="48"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{ThemeResource ToggleTrackBrush}"
                                    BorderBrush="{ThemeResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Padding="3,0">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Fill="{ThemeResource ToggleThumbBrush}"
                                        Stroke="{ThemeResource GlassBorderBrush}"
                                        StrokeThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="{x:Bind ViewModel.ToggleThumbAlignment, Mode=OneWay}" />
                                </Border>
                            </Button>
                        </Grid>

                        <!-- Fluid Typing Animation Toggle -->
                        <Grid>
                            <TextBlock
                                Text="Fluid typing"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                HorizontalAlignment="Right"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ToggleFluidAnimationCommand}"
                                ToolTipService.ToolTip="Toggle fluid typing animation">
                                <Border
                                    Width="48"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{ThemeResource ToggleTrackBrush}"
                                    BorderBrush="{ThemeResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Padding="3,0">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Fill="{ThemeResource ToggleThumbBrush}"
                                        Stroke="{ThemeResource GlassBorderBrush}"
                                        StrokeThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="{x:Bind ViewModel.FluidToggleThumbAlignment, Mode=OneWay}" />
                                </Border>
                            </Button>
                        </Grid>

                        <!-- Tree Shortcut Toggle -->
                        <Grid>
                            <TextBlock
                                Text="Tree shortcut (Shift+Enter)"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                HorizontalAlignment="Right"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ToggleTreeShortcutCommand}"
                                ToolTipService.ToolTip="Insert connected tree branches with Shift+Enter">
                                <Border
                                    Width="48"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="{ThemeResource ToggleTrackBrush}"
                                    BorderBrush="{ThemeResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Padding="3,0">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Fill="{ThemeResource ToggleThumbBrush}"
                                        Stroke="{ThemeResource GlassBorderBrush}"
                                        StrokeThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="{x:Bind ViewModel.TreeToggleThumbAlignment, Mode=OneWay}" />
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sidebar Footer -->
                <StackPanel
                    Grid.Row="3"
                    Padding="16,0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Button
                        Style="{StaticResource GlassIconButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <TextBlock
                        Text="{x:Bind ViewModel.NoteCountText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Main Editor -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="EditorTextBox"
                    Grid.Row="0"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    IsSpellCheckEnabled="False"
                    MinHeight="0"
                    PlaceholderText="Start writing..."
                    Text="{x:Bind ViewModel.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="16"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="48,32,48,16"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.RenderTransform>
                        <TranslateTransform x:Name="EditorTranslate" />
                    </TextBox.RenderTransform>
                    <TextBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F7" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8E8E93" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8E8E93" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8E8E93" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlForeground" Color="#FF1C1C1E" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF1C1C1E" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1C1C1E" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6C6C70" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6C6C70" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF6C6C70" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </TextBox.Resources>
                </TextBox>

                <!-- Fluid Typing Glow Bar -->
                <Border
                    x:Name="FluidTypingBar"
                    Grid.Row="1"
                    Margin="48,0"
                    CornerRadius="1"
                    Opacity="0"
                    Background="{ThemeResource GlassBorderBrush}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="FluidBarScale" ScaleX="0.2" />
                    </Border.RenderTransform>
                </Border>

                <!-- Status Bar -->
                <Grid Grid.Row="2" Padding="48,0">
                    <TextBlock
                        x:Name="WordCountLabel"
                        Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="WordCountTranslate" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock
                        Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
